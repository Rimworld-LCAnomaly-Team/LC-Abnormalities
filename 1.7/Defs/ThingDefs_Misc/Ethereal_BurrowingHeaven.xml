<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <LCAnomalyCore.Defs.ThingDef_AbnormalityEntity_Spawn ParentName="EtherealThingBase">
    <defName>DyingBurrowingHeaven</defName>
    <modExtensions><li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory"><abnormalityCategoryDef>WAW</abnormalityCategoryDef></li></modExtensions>
    <selectable>false</selectable>
    <tickerType>Normal</tickerType>
    <thingClass>BurrowingHeaven.Effect.DyingBurrowingHeaven</thingClass>
    <drawOffscreen>true</drawOffscreen>
  </LCAnomalyCore.Defs.ThingDef_AbnormalityEntity_Spawn>

  <ThingDef ParentName="EtherealThingBase">
    <defName>BurrowingHeaven_KillTree</defName>
    <label>burrowing heaven blood branch</label>
    <description>A jagged crimson branch sprouted in a pool of blood where The Burrowing Heaven claimed a victim.</description>
    <thingClass>ThingWithComps</thingClass>
    <selectable>true</selectable>
    <tickerType>Rare</tickerType>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Special/BurrowingHeaven_KillTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(2.2, 2.2)</drawSize>
    </graphicData>
    <comps>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>30000</lifespanTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>LC_HeavenThrustFX</defName>
    <label>heaven thrust fx</label>
    <thingClass>BurrowingHeaven.Effect.Thing_HeavenSpearThrust</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <altitudeLayer>MoteOverhead</altitudeLayer>
  </ThingDef>

  <ThingDef>
    <defName>LC_HeavenChargeAuraFX</defName>
    <label>heaven charge aura fx</label>
    <thingClass>BurrowingHeaven.Effect.Thing_HeavenChargeAura</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <altitudeLayer>MoteOverhead</altitudeLayer>
  </ThingDef>

  <ThingDef>
    <defName>LC_HeavenSkillRunnerFX</defName>
    <label>heaven skill runner fx</label>
    <thingClass>BurrowingHeaven.Effect.Thing_HeavenSkillRunner</thingClass>
    <category>Ethereal</category>
    <tickerType>Normal</tickerType>
    <drawerType>None</drawerType>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
  </ThingDef>

