<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_Apparel_EGO">
    <defName>Apparel_PpodaeSuit</defName>
    <label>E.G.O. Suit (SO CUTE!!!)</label>
    <description>A warm white fur-trimmed harness jacket extracted from Ppodae (TETH).\nOffers dependable resistance against Red and Black harm while keeping wearers nimble.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/PpodaeSuit/PpodaeSuit</texPath>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>0.58</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.44</ArmorRating_Blunt>
      <ArmorRating_Heat>0.38</ArmorRating_Heat>
      <Insulation_Cold>24</Insulation_Cold>
      <Insulation_Heat>12</Insulation_Heat>
      <Mass>2.6</Mass>
      <EquipDelay>6</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.08</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li><li>Legs</li><li>Arms</li><li>Neck</li><li>Shoulders</li><li>Feet</li><li>Hands</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/PpodaeSuit/PpodaeSuit</wornGraphicPath>
      <layers><li>Middle</li><li>Shell</li></layers>
      <useDeflectMetalEffect>false</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
    </apparel>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorApparelExtension">
        <riskLevel>TETH</riskLevel>
        <redResistance>0.8</redResistance>
        <whiteResistance>1.5</whiteResistance>
        <blackResistance>0.8</blackResistance>
        <paleResistance>2.0</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

