<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="Apparel_ScorchedGirlSuit" ParentName="LC_Apparel_EGO">
    <defName>Apparel_ScorchedGirlSuit</defName>
    <label>E.G.O. Suit (Fourth Match Flame)</label>
    <description>A charred, ember-lined coat stitched from glowing ash (TETH).\nProvides high Red and heat insulation while faintly dampening psychic calm.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/ScorchedGirlSuit/ScorchedGirlSuit</texPath>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>0.78</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.46</ArmorRating_Blunt>
      <ArmorRating_Heat>0.85</ArmorRating_Heat>
      <Insulation_Cold>16</Insulation_Cold>
      <Insulation_Heat>38</Insulation_Heat>
      <Mass>3.4</Mass>
      <EquipDelay>8</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.08</MoveSpeed>
      <Flammability>-0.35</Flammability>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li><li>Legs</li><li>Arms</li><li>Neck</li><li>Shoulders</li><li>Feet</li><li>Hands</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ScorchedGirlSuit/ScorchedGirlSuit</wornGraphicPath>
      <layers><li>Middle</li><li>Shell</li></layers>
      <useDeflectMetalEffect>false</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
    </apparel>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorApparelExtension">
        <riskLevel>TETH</riskLevel>
        <redResistance>0.6</redResistance>
        <whiteResistance>1.0</whiteResistance>
        <blackResistance>1.2</blackResistance>
        <paleResistance>2.0</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

