<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="Apparel_FairyFestivalSuit" ParentName="LC_Apparel_EGO">
    <defName>Apparel_FairyFestivalSuit</defName>
    <label>E.G.O. Suit (Wingbeat)</label>
    <description>A pale moss-green robe woven with translucent fairy filaments (ZAYIN).\nLight as mist, it lets the wearer tend to work quickly while keeping them agile.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/FairyFestivalSuit/FairyFestivalSuit</texPath>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>0.58</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.32</ArmorRating_Blunt>
      <ArmorRating_Heat>0.40</ArmorRating_Heat>
      <Insulation_Cold>18</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <Mass>2.2</Mass>
      <EquipDelay>6</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.10</MoveSpeed>
      <WorkSpeedGlobal>0.06</WorkSpeedGlobal>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li><li>Legs</li><li>Arms</li><li>Neck</li><li>Shoulders</li><li>Feet</li><li>Hands</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/FairyFestivalSuit/FairyFestivalSuit</wornGraphicPath>
      <layers>
        <li>Middle</li><li>Shell</li>
      </layers>
      <useDeflectMetalEffect>false</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
    </apparel>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorApparelExtension">
        <riskLevel>ZAYIN</riskLevel>
        <redResistance>0.8</redResistance>
        <whiteResistance>0.8</whiteResistance>
        <blackResistance>1.0</blackResistance>
        <paleResistance>2.0</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

