<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="Apparel_BurrowingHeavenSuit" ParentName="LC_Apparel_EGO">
    <defName>Apparel_BurrowingHeavenSuit</defName>
    <label>E.G.O.Suit (Heaven)</label>
    <description>An unnerving formal coat woven with crimson tendrils and a watching eye fixed at its core.\nWhen the wearer is observed by allies, the suit tightens around their frame like steadfast bark; left unseen, it thirsts for spilled blood.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/BurrowingHeavenSuit/BurrowingHeavenSuit</texPath>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>0.95</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.55</ArmorRating_Blunt>
      <ArmorRating_Heat>0.65</ArmorRating_Heat>
      <Insulation_Cold>20</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <Mass>5</Mass>
      <EquipDelay>10</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.10</MoveSpeed>
      <MeleeDodgeChance>2.00</MeleeDodgeChance>
      <MeleeHitChance>1.50</MeleeHitChance>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
        <li>Arms</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Feet</li>
        <li>Hands</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/BurrowingHeavenSuit/BurrowingHeavenSuit</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
    </apparel>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorApparelExtension">
        <riskLevel>WAW</riskLevel>
        <redResistance>1.2</redResistance>
        <whiteResistance>0.8</whiteResistance>
        <blackResistance>0.6</blackResistance>
        <paleResistance>1.5</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
