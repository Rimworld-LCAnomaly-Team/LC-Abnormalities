<Defs>

  <ThingDef ParentName="LC_Apparel_AccessoryBase">
    <defName>Accessory_Ppodae</defName>
    <label>Accessory (SO CUTE!!!)</label>
    <description>Fluffy white puppy ears gifted by Ppodae. Toughens the wearer's stamina and healing at the cost of slight clumsiness during delicate lab work.</description>
    <thingCategories><li>LC_Apparel_Accessory_EGO</li></thingCategories>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Accessory/PpodaeAccessory</texPath>
    </graphicData>
    <statBases><Beauty>4</Beauty></statBases>
    <apparel>
      <layers><li>LC_AccessoryHead</li></layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <bodyPartGroups><li>FullHead</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Accessory/PpodaeAccessory</wornGraphicPath>
