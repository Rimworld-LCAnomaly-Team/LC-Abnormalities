<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="Apparel_AllAroundHelperSuit" ParentName="LC_Apparel_EGO">
    <defName>Apparel_AllAroundHelperSuit</defName>
    <label>E.G.O. Suit (Grinder Mk4)</label>
    <description>A sterile white ceramic-plated utility jacket extracted from All-Around Helper (HE).\nGuards reliably against Red lacerations while slightly boosting movement agility.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/AllAroundHelperSuit/AllAroundHelperSuit</texPath>
    </graphicData>
    <statBases>
      <ArmorRating_Sharp>0.90</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.58</ArmorRating_Blunt>
      <ArmorRating_Heat>0.55</ArmorRating_Heat>
      <Insulation_Cold>20</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <Mass>3.6</Mass>
      <EquipDelay>8</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.12</MoveSpeed>
      <WorkSpeedGlobal>0.06</WorkSpeedGlobal>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li><li>Legs</li><li>Arms</li><li>Neck</li><li>Shoulders</li><li>Feet</li><li>Hands</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/AllAroundHelperSuit/AllAroundHelperSuit</wornGraphicPath>
      <layers><li>Middle</li><li>Shell</li></layers>
      <useDeflectMetalEffect>false</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
    </apparel>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorApparelExtension">
        <riskLevel>HE</riskLevel>
        <redResistance>0.6</redResistance>
        <whiteResistance>1.3</whiteResistance>
        <blackResistance>0.9</blackResistance>
        <paleResistance>1.5</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

