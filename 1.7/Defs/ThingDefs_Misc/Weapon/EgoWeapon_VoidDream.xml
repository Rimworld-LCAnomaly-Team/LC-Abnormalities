<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_BaseRangedWeapon_EGO">
    <defName>EgoWeapon_VoidDream</defName>
    <label>E.G.O. Weapon (Engulfing Dream)</label>
    <description>A bizarre TETH-grade E.G.O. sidearm shaped like Void Dream's crimson-masked rooster head mounted atop a tuft of fluffy white wool.\nRapidly launches twin harmonic White sonic pulses that jolt dazed minds awake and erode enemy sanity from mid-range.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/EgoWeapon_VoidDream</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.28, 1.28)</drawSize>
    </graphicData>
    <uiIconScale>1.20</uiIconScale>
    <soundInteract>Interact_Autopistol</soundInteract>
    <statBases>
      <Mass>2.2</Mass>
      <AccuracyTouch>0.82</AccuracyTouch>
      <AccuracyShort>0.88</AccuracyShort>
      <AccuracyMedium>0.85</AccuracyMedium>
      <AccuracyLong>0.72</AccuracyLong>
      <RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>LCAbnormalities.VoidDream.Verb_ShootVoidDreamEgo</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EgoWeapon_VoidDream</defaultProjectile>
        <warmupTime>0.45</warmupTime>
        <range>24</range>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>LC_VoidDream_EgoShot</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>beak</label>
        <capacities><li>Blunt</li></capacities>
        <power>7</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>White</damageType>
        <riskLevel>TETH</riskLevel>
        <damageMultiplier>1</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LC_BaseBullet_EGO">
    <defName>Bullet_EgoWeapon_VoidDream</defName>
    <label>Engulfing Dream sonic pulse</label>
    <thingClass>LCAbnormalities.VoidDream.Projectile_VoidDreamEgo</thingClass>
    <projectile>
      <damageDef>LC_WhiteDamage</damageDef>
      <damageAmountBase>7</damageAmountBase>
      <armorPenetrationBase>0.30</armorPenetrationBase>
      <stoppingPower>0.9</stoppingPower>
      <speed>118</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Projectile_VoidDream</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
  </ThingDef>

</Defs>
