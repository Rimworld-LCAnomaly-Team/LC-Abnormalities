<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_BaseRangedWeapon_EGO">
    <defName>EgoWeapon_VoidDream</defName>
    <label>E.G.O. Weapon (Dreamy)</label>
    <description>A twilight-violet rifle inlaid with unblinking crimson eyes (TETH).\nFires unsettling White mental bolts capable of staggering foes from mid-range.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/EgoWeapon_VoidDream</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.9, 1.9)</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <Mass>3.0</Mass>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.86</AccuracyShort>
      <AccuracyMedium>0.88</AccuracyMedium>
      <AccuracyLong>0.78</AccuracyLong>
      <RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EgoWeapon_VoidDream</defaultProjectile>
        <warmupTime>0.75</warmupTime>
        <range>27</range>
        <soundCast>Shot_Rifle_EgoBase</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>8</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities><li>Blunt</li></capacities>
        <power>8</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>White</damageType>
        <riskLevel>TETH</riskLevel>
        <damageMultiplier>1</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LC_BaseBullet_EGO">
    <defName>Bullet_EgoWeapon_VoidDream</defName>
    <label>Dreamy E.G.O. bolt</label>
    <projectile>
      <damageAmountBase>13</damageAmountBase>
      <armorPenetrationBase>0.30</armorPenetrationBase>
      <stoppingPower>1.3</stoppingPower>
      <speed>110</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

</Defs>
