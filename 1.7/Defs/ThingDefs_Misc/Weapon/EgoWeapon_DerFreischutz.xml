<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_BaseRangedWeapon_EGO">
    <defName>EgoWeapon_DerFreischutz</defName>
    <label>E.G.O. Weapon (Magic Bullet)</label>
    <description>The WAW-grade enchanted long rifle forged in a dark pact with Der Freischütz.\nFires piercing Black rounds to range 44 that tear cleanly through every living creature in their path—friend and foe alike.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/EgoWeapon_DerFreischutz</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.2, 2.2)</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <Mass>4.2</Mass>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.88</AccuracyShort>
      <AccuracyMedium>0.95</AccuracyMedium>
      <AccuracyLong>0.92</AccuracyLong>
      <RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EgoWeapon_DerFreischutz</defaultProjectile>
        <warmupTime>1.3</warmupTime>
        <range>44</range>
        <soundCast>LC_DerFreischutz_Shoot</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>11</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities><li>Blunt</li></capacities>
        <power>11</power>
        <cooldownTime>2.0</cooldownTime>
      </li>
    </tools>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>Black</damageType>
        <riskLevel>WAW</riskLevel>
        <damageMultiplier>1</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LC_BaseBullet_EGO">
    <defName>Bullet_EgoWeapon_DerFreischutz</defName>
    <label>Magic Bullet E.G.O. round</label>
    <thingClass>LCAbnormalities.DerFreischutz.Projectile_EgoMagicBullet</thingClass>
    <projectile>
      <damageDef>LC_BlackDamage</damageDef>
      <damageAmountBase>26</damageAmountBase>
      <armorPenetrationBase>0.75</armorPenetrationBase>
      <stoppingPower>2.0</stoppingPower>
      <speed>135</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Projectile_MagicBullet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="LC_BaseBullet_EGO">
    <defName>MagicBullet_Request</defName>
    <label>Contract Magic Bullet</label>
    <thingClass>LCAbnormalities.DerFreischutz.Projectile_MagicBullet</thingClass>
    <projectile>
      <damageDef>LC_BlackDamage</damageDef>
      <damageAmountBase>52</damageAmountBase>
      <armorPenetrationBase>0.80</armorPenetrationBase>
      <stoppingPower>3.0</stoppingPower>
      <speed>150</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Projectile_MagicBullet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

</Defs>
