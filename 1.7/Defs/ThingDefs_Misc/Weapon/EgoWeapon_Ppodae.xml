<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_BaseMeleeWeapon_EGO">
    <defName>EgoWeapon_Ppodae</defName>
    <label>E.G.O. Weapon (SO CUTE!!!)</label>
    <description>Deceptively plush white puppy-paw gauntlets extracted from Ppodae (TETH).\nConceals bone-crushing Red fist power behind soft fur.</description>
    <thingClass>ThingWithComps</thingClass>
    <equippedAngleOffset>-25</equippedAngleOffset>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/EgoWeapon_Ppodae</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5, 1.5)</drawSize>
    </graphicData>
    <statBases>
      <Mass>1.8</Mass>
    </statBases>
    <tools>
      <li>
        <label>frenzy paw</label>
        <capacities>
          <li>LC_PpodaeEgoFist</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.35</cooldownTime>
        <soundMeleeHit>LC_Ppodae_Fist</soundMeleeHit>
      </li>
    </tools>
    <descriptionHyperlinks>
      <AbilityDef>SoCute_FrenzyMaul</AbilityDef>
    </descriptionHyperlinks>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>SoCute_FrenzyMaul</abilityDef>
      </li>
      <li Class="CompProperties_Styleable"/>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>Red</damageType>
        <riskLevel>TETH</riskLevel>
        <damageMultiplier>1</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
