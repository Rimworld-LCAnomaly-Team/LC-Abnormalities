<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_BaseMeleeWeapon_EGO">
    <defName>EgoWeapon_SnowQueen</defName>
    <label>E.G.O. Weapon (Frost Splinter)</label>
    <description>A jagged spear of eternal glacier crystal extracted from The Snow Queen (HE).\nIts frigid White thrusts numb living victims, slowing their movement with clinging frost.</description>
    <descriptionHyperlinks>
      <AbilityDef>FrostSplinter_GlacialDuel</AbilityDef>
    </descriptionHyperlinks>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/EgoWeapon_SnowQueen</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.1, 2.1)</drawSize>
    </graphicData>
    <statBases>
      <Mass>2.6</Mass>
    </statBases>
    <tools>
      <li>
        <label>frost lance</label>
        <capacities>
          <li>LC_FrostSplinterCleave</li>
        </capacities>
        <power>17</power>
        <cooldownTime>1.45</cooldownTime>
      </li>
    </tools>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>FrostSplinter_GlacialDuel</abilityDef>
      </li>
      <li Class="CompProperties_Styleable"/>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>White</damageType>
        <riskLevel>HE</riskLevel>
        <damageMultiplier>1</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
