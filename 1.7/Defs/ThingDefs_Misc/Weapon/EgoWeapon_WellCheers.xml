<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_BaseRangedWeapon_EGO">
    <defName>EgoWeapon_WellCheers</defName>
    <label>E.G.O. Weapon (Soda)</label>
    <description>A pistol painted in a refreshing grape purple, last extracted by an employee who particularly loved shrimp (ZAYIN).\nWhenever fired, a faint scent of grapes and sparkling soda fizz waft through the air; rapid long-range Red bolts have a chance to soothe the shooter's wounds and nerves.</description>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/EgoWeapon_WellCheers</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.78, 0.78)</drawSize>
    </graphicData>
    <uiIconScale>1.30</uiIconScale>
    <soundInteract>Interact_Autopistol</soundInteract>
    <statBases>
      <Mass>1.4</Mass>
      <AccuracyTouch>0.84</AccuracyTouch>
      <AccuracyShort>0.86</AccuracyShort>
      <AccuracyMedium>0.78</AccuracyMedium>
      <AccuracyLong>0.64</AccuracyLong>
      <RangedWeapon_Cooldown>0.55</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>LCAbnormalities.WellCheers.Verb_ShootWellCheersEgo</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EgoWeapon_WellCheers</defaultProjectile>
        <warmupTime>0.35</warmupTime>
        <range>24</range>
        <soundCast>LC_WellCheers_EgoShot</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities><li>Blunt</li></capacities>
        <power>6</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
    <descriptionHyperlinks>
      <AbilityDef>Soda_RefreshingSplash</AbilityDef>
    </descriptionHyperlinks>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>Soda_RefreshingSplash</abilityDef>
      </li>
      <li Class="CompProperties_Styleable"/>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponGun</nameMaker>
        <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>Red</damageType>
        <riskLevel>ZAYIN</riskLevel>
        <damageMultiplier>1</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LC_BaseBullet_EGO">
    <defName>Bullet_EgoWeapon_WellCheers</defName>
    <label>Soda E.G.O. bolt</label>
    <thingClass>LCAbnormalities.WellCheers.Projectile_WellCheersSoda</thingClass>
    <projectile>
      <damageDef>LC_Soda_RedHeal</damageDef>
      <damageAmountBase>7</damageAmountBase>
      <armorPenetrationBase>0.15</armorPenetrationBase>
      <stoppingPower>0.8</stoppingPower>
      <speed>112</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Projectile_WellCheersSoda</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(0.68, 0.95)</drawSize>
    </graphicData>
  </ThingDef>

</Defs>
