<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_BaseRangedWeapon_EGO">
    <defName>EgoWeapon_Laetitia</defName>
    <label>E.G.O. Weapon (Laetitia)</label>
    <description>It takes a lot of time to extract, but its power cannot be ignored.\nThe crude design appears to have been made a long time ago.\nThe small accessory remains like the wishes of a child who yearned for happiness.</description>
    <descriptionHyperlinks>
      <AbilityDef>LaetitiaEGO_SendTheGift</AbilityDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/EgoWeapon_Laetitia</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2, 2)</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <Mass>3.5</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.90</AccuracyMedium>
      <AccuracyLong>0.80</AccuracyLong>
      <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Laetitia.Effect.Verb_ShootLaetitia</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EgoWeapon_Laetitia</defaultProjectile>
        <warmupTime>0.9</warmupTime>
        <range>28</range>
        <soundCast>Shot_Rifle_EgoBase</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <!-- 覆盖 BaseWeapon 的 CompEquippable，避免与 CompEquippableAbility 重复注册 Verb LoadID -->
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>LaetitiaEGO_SendTheGift</abilityDef>
      </li>
      <li Class="CompProperties_Styleable"/>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponGun</nameMaker>
        <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>Black</damageType>
        <riskLevel>HE</riskLevel>
        <damageMultiplier>1</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="LC_BaseBullet_EGO">
    <defName>Bullet_EgoWeapon_Laetitia</defName>
    <label>Laetitia E.G.O. bullet</label>
    <thingClass>Laetitia.Effect.Projectile_LaetitiaShot</thingClass>
    <projectile>
      <damageAmountBase>15</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>120</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/Bullet_big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <!-- SendTheGift -->
  <AbilityDef>
    <defName>LaetitiaEGO_SendTheGift</defName>
    <label>Send The Gift</label>
    <description>Fire a two-beat enchanted Heart-Lace volley at any non-allied living target (range 25), dealing Black damage and affixing an aggressive Gift.\nFollow-up hits from Laetitia's E.G.O. rifle deal +25% bonus Black damage and shatter the gift faster into an ally-safe Heartbreak Black-Lace AoE detonation (stunning and blasting nearby hostiles within 3.6 cells).</description>
    <iconPath>UI/Abilities/SendTheGift</iconPath>
    <cooldownTicksRange>1080</cooldownTicksRange>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <aiCanUse>true</aiCanUse>
    <warmupStartSound>Shot_Rifle_EgoBase</warmupStartSound>
    <showOnCharacterCard>false</showOnCharacterCard>
    <verbProperties>
      <verbClass>Laetitia.Effect.Verb_CastAbility_LaetitiaGift</verbClass>
      <requireLineOfSight>true</requireLineOfSight>
      <range>24.9</range>
      <warmupTime>0.55</warmupTime>
      <soundCast>Shot_Rifle_EgoBase</soundCast>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Laetitia.Comp.CompProperties_AbilitySendTheGift">
      </li>
    </comps>
  </AbilityDef>

</Defs>
