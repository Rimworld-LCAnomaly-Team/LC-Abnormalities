<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>LC_FairyCare</defName>
    <label>Fairy's Care</label>
    <description>Guarded and tended by Fairy Festival. Slowly mends surface bruises and calms nerves over time.\n\nWARNING: Starting containment work on ANY other Abnormality while cared for invites immediate fatal devouring.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.95, 0.72)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="LCAbnormalities.FairyFestival.HediffCompProperties_FairyCare">
        <healPerPulse>2.0</healPerPulse>
        <mentalRestorePerPulse>0.03</mentalRestorePerPulse>
        <pulseIntervalTicks>250</pulseIntervalTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_WellCheers_Red</defName>
    <label>Cherry Soda Glow</label>
    <description>Refreshed by a cherry-red can from WellCheers, invigorating endurance and pain tolerance.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.35, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <painFactor>0.85</painFactor>
        <statOffsets>
          <InjuryHealingFactor>0.15</InjuryHealingFactor>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_WellCheers_Blue</defName>
    <label>Sea Soda Clarity</label>
    <description>Cooled by a sea-blue can from WellCheers, sharpening focus and steadying nerves.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.35, 0.75, 0.98)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.08</MentalBreakThreshold>
          <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_WellCheers_Purple</defName>
    <label>Twilight Soda Blend</label>
    <description>Balanced blend of grape and sea soda from WellCheers, uplifting both body and spirit.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.78, 0.45, 0.96)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <painFactor>0.90</painFactor>
        <statOffsets>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
          <MoveSpeed>0.15</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_WellCheers_DeepSleep</defName>
    <label>Open-Sea Slumber</label>
    <description>Drugged by a tainted can of WellCheers. The drinker has collapsed unconscious into freezing sea dreams.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.35, 0.55, 0.92)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-15.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_PunishingBirdEnragedBuff</defName>
    <label>Enraged Judgement</label>
    <description>Provoked into tearing open its crimson maw, Punishing Bird darts forward at blinding speed.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.15, 0.15)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>4.5</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>LC_VoidDreamSleep</defName>
    <label>Void Hypnosis</label>
    <description>Captured inside Void Dream's hypnotic crow.\nIf allies do not shake the sleeper awake within 60 seconds, a catastrophic White/Black nightmare erupts.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.68, 0.42, 0.95)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="LCAbnormalities.VoidDream.HediffCompProperties_VoidDreamSleep">
        <nightmareTimeoutTicks>3600</nightmareTimeoutTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_HeartOfAspirationBuff</defName>
    <label>Throbbing Aspiration</label>
    <description>Connected to The Heart of Aspiration.\nGrants surge speed and melee might, yet demands combat bloodshed within 60 seconds and before being returned.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.96, 0.35, 0.42)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <painFactor>0.80</painFactor>
        <statFactors>
          <MoveSpeed>1.20</MoveSpeed>
          <WorkSpeedGlobal>1.20</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <MeleeDamageFactor>0.25</MeleeDamageFactor>
          <LC_AbnormalityStudyRate>0.15</LC_AbnormalityStudyRate>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="LCAbnormalities.HeartOfAspiration.HediffCompProperties_HeartOfAspiration" />
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

</Defs>
