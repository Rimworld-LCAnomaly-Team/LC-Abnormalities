<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>LC_PortraitProtected</defName>
    <label>portrait ward</label>
    <description>Bound as the subject of Portrait of Another World. Incoming physical and mental harm is intercepted and transferred to the marked substitute.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.98, 0.85, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="PortraitOfAnotherWorld.Comp.HediffCompProperties_PortraitLink">
        <isProtected>true</isProtected>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_PortraitSubstitute</defName>
    <label>portrait substitute</label>
    <description>Marked by Portrait of Another World. All damage meant for the bound ward strikes this pawn instead; dying here stains the painting crimson.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.92, 0.32, 0.32)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="PortraitOfAnotherWorld.Comp.HediffCompProperties_PortraitLink">
        <isProtected>false</isProtected>
      </li>
    </comps>
  </HediffDef>

</Defs>
