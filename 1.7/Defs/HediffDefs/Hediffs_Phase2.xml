<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>LC_SnowQueenKiss</defName>
    <label>The Snow Queen's Kiss</label>
    <description>A frost-petal kiss left by The Snow Queen (received on Normal 50% or Bad 100% work).\nReceiving a second Kiss traps the worker inside her crystalline ice coffin; expires after one day or upon winning a duel.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.85, 1.0)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>-0.15</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="LCAbnormalities.SnowQueen.HediffCompProperties_SnowQueenKiss" />
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_FrostSlow</defName>
    <label>Glacial Chill</label>
    <description>Numbed by Frost Splinter, sharply reducing movement speed for 5 seconds.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.52, 0.88, 1.0)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.60</MoveSpeed>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="LCAbnormalities.SnowQueen.HediffCompProperties_FrostSlowVfx" />
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LC_ResearcherNoteBuff</defName>
    <label>Crazed Research Insights</label>
    <description>Possessed by the frantic brilliance of Notes from a Crazed Researcher.\nGreatly speeds up work, research, and Abnormality study (+50% Speed, +10% Study Success Rate), yet triggers a lethal RED gore blast at 60 cumulative HP/SP damage or on premature return.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.90, 0.72, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statFactors>
          <WorkSpeedGlobal>1.50</WorkSpeedGlobal>
          <ResearchSpeed>1.50</ResearchSpeed>
          <LC_AbnormalityStudyRate>1.50</LC_AbnormalityStudyRate>
          <MoveSpeed>1.20</MoveSpeed>
          <GlobalLearningFactor>1.25</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="LCAbnormalities.NotesFromCrazedResearcher.HediffCompProperties_ResearcherNote">
        <maxCumulativeDamage>60</maxCumulativeDamage>
        <studySuccessRateBonus>0.10</studySuccessRateBonus>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

</Defs>
