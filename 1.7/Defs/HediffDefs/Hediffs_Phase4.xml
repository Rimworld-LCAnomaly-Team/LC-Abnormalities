<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>LC_CosmicEnlightenment</defName>
    <label>Cosmic Enlightenment</label>
    <description>An iridescent psychic veil resonated by E.G.O. 'Fragments from Somewhere'. Absorbs up to 50 White or Black damage until depleted or expired.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.76, 0.56, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.08</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="LCAbnormalities.FragmentOfTheUniverse.HediffCompProperties_CosmicEnlightenment">
        <maxShield>50</maxShield>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

</Defs>
