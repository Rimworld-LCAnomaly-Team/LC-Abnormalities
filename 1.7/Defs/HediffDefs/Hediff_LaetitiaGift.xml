<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <HediffDef>
    <defName>LaetitiaGift</defName>
    <label>Laetitia's Gift</label>
    <labelNoun>This one was given a gift from Laetitia during work, and this hediff will last for one day.</labelNoun>
    <description>When a work result is Normal or Bad, Laetitia will give the employee a gift, and a red heart will appear above the employee's head (if an employee already carries a gift and gets a Bad result, it bursts immediately).\nIf an employee carries Laetitia's gift and approaches another Abnormality's holding platform to work on it without cancelling in time, the gift will explode, killing the carrier and spawning a Little Witch's Friend.</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <renderNodeProperties>
      <li Class="LCAnomalyCore.Render.PawnRenderNodeProperties_HediffUpHead">
        <texPaths>
          <li>UI/Hediff/HeartNormal</li>
        </texPaths>
        <parentTagDef>Body</parentTagDef>
        <overrideMeshSize>1</overrideMeshSize>
        <drawSize>0.8</drawSize>
        <colorType>Custom</colorType>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <offsetRangeZ>0~0</offsetRangeZ>
        <durationTicksRange>600~600</durationTicksRange>
        <nextSpasmTicksRange>600~600</nextSpasmTicksRange>
        <drawData>
          <scaleOffsetByBodySize>false</scaleOffsetByBodySize>
          <useBodyPartAnchor>false</useBodyPartAnchor>
          <defaultData>
            <layer>49</layer>
            <offset>(0, 0, 1.2)</offset>
            <flip>false</flip>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="Laetitia.Comp.HediffCompProperties_LaetitiaGift">
        <deathDistance>3.0</deathDistance>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>LaetitiaGiftAggresive</defName>
    <label>Laetitia's Gift (Aggressive)</label>
    <labelNoun>This one has been gifted aggressively by E.G.O. Laetitia, and this hediff will soon end.</labelNoun>
    <description>Unlike gifts obtained during work, this aggressive gift expires rapidly.\nWhen it expires or the target is downed or killed, it unleashes a heavy Black damage burst. If the target falls, one or two temporary hostile Little Witch's Friends burst forth from the body.</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <renderNodeProperties>
      <li Class="LCAnomalyCore.Render.PawnRenderNodeProperties_HediffUpHead">
        <texPaths>
          <li>UI/Hediff/HeartBroken</li>
        </texPaths>
        <parentTagDef>Body</parentTagDef>
        <overrideMeshSize>1</overrideMeshSize>
        <drawSize>0.8</drawSize>
        <colorType>Custom</colorType>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <offsetRangeZ>0~0</offsetRangeZ>
        <durationTicksRange>600~600</durationTicksRange>
        <nextSpasmTicksRange>600~600</nextSpasmTicksRange>
        <drawData>
          <scaleOffsetByBodySize>false</scaleOffsetByBodySize>
          <useBodyPartAnchor>false</useBodyPartAnchor>
          <defaultData>
            <layer>49</layer>
            <offset>(0, 0, 1.2)</offset>
            <flip>false</flip>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-48.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="Laetitia.Comp.HediffCompProperties_LaetitiaGiftAggresive">
        <spawnAmount>1~2</spawnAmount>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

</Defs>
