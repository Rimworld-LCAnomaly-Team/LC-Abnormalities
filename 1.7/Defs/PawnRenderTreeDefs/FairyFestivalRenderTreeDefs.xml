<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <PawnRenderTreeDef>
    <defName>FairyFestival</defName>
    <root Class="PawnRenderNodeProperties_Parent">
      <debugLabel>Root</debugLabel>
      <tagDef>Root</tagDef>
      <children>
        <!-- F-04-83 Fairy Festival articulated Spine multi-part rig (Fairy.txt / Fairy.atlas.txt) -->
        <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
          <debugLabel>Fairy_Root</debugLabel>
          <tagDef>Fairy_Root</tagDef>
          <role>Root</role>
          <useGraphic>false</useGraphic>
          <formScale>2.05</formScale>
          <children>
            <!-- Hovering Body Group (drives figure-8 mid-air bobbing for entire fairy) -->
            <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
              <debugLabel>Fairy_BodyGroup</debugLabel>
              <tagDef>Fairy_BodyGroup</tagDef>
              <role>BodyGroup</role>
              <useGraphic>false</useGraphic>
              <children>

                <!-- Bioluminescent Shimmer Aura behind/around body -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_AuraShimmer</debugLabel>
                  <tagDef>Fairy_AuraShimmer</tagDef>
                  <role>AuraShimmer</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/AuraShimmer</texPath>
                  <useGlowShader>true</useGlowShader>
                  <baseLayer>3.5</baseLayer>
                </li>

                <!-- Four Luminous Translucent Insect Wings (exact shoulder pivots) -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_WingBackUpper</debugLabel>
                  <tagDef>Fairy_WingBackUpper</tagDef>
                  <role>Wing</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/WingBackUpper</texPath>
                  <useTransparentShader>true</useTransparentShader>
                  <baseLayer>4.0</baseLayer>
                </li>
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_WingBackLower</debugLabel>
                  <tagDef>Fairy_WingBackLower</tagDef>
                  <role>Wing</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/WingBackLower</texPath>
                  <useTransparentShader>true</useTransparentShader>
                  <baseLayer>4.2</baseLayer>
                </li>
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_WingFrontUpper</debugLabel>
                  <tagDef>Fairy_WingFrontUpper</tagDef>
                  <role>Wing</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/WingFrontUpper</texPath>
                  <useTransparentShader>true</useTransparentShader>
                  <baseLayer>4.6</baseLayer>
                </li>
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_WingFrontLower</debugLabel>
                  <tagDef>Fairy_WingFrontLower</tagDef>
                  <role>Wing</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/WingFrontLower</texPath>
                  <useTransparentShader>true</useTransparentShader>
                  <baseLayer>4.8</baseLayer>
                </li>

                <!-- Tail -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_Tail</debugLabel>
                  <tagDef>Fairy_Tail</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/Tail</texPath>
                  <baseLayer>5.2</baseLayer>
                </li>

                <!-- Legs -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_LegBack</debugLabel>
                  <tagDef>Fairy_LegBack</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/LegBack</texPath>
                  <baseLayer>5.6</baseLayer>
                </li>
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_LegFront</debugLabel>
                  <tagDef>Fairy_LegFront</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/LegFront</texPath>
                  <baseLayer>6.0</baseLayer>
                </li>

                <!-- Back Arms -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_ArmBackLower</debugLabel>
                  <tagDef>Fairy_ArmBackLower</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/ArmBackLower</texPath>
                  <baseLayer>6.4</baseLayer>
                </li>
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_ArmBackUpper</debugLabel>
                  <tagDef>Fairy_ArmBackUpper</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/ArmBackUpper</texPath>
                  <baseLayer>6.6</baseLayer>
                </li>

                <!-- Plump Torso & Collar -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_Body</debugLabel>
                  <tagDef>Fairy_Body</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/Body</texPath>
                  <baseLayer>7.0</baseLayer>
                </li>

                <!-- Front Arms -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_ArmFrontLower</debugLabel>
                  <tagDef>Fairy_ArmFrontLower</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/ArmFrontLower</texPath>
                  <baseLayer>7.4</baseLayer>
                </li>
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_ArmFrontUpper</debugLabel>
                  <tagDef>Fairy_ArmFrontUpper</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/ArmFrontUpper</texPath>
                  <baseLayer>7.6</baseLayer>
                </li>

                <!-- Head + Dynamic Eyes (glowing #00FF82 on Give_fairy / crimson on Feast) + Dynamic Mouth (mouth1/mouth2) -->
                <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                  <debugLabel>Fairy_Head</debugLabel>
                  <tagDef>Fairy_Head</tagDef>
                  <role>StaticPart</role>
                  <texPath>Things/Pawn/FairyFestival/Parts/Head</texPath>
                  <baseLayer>8.0</baseLayer>
                  <children>
                    <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                      <debugLabel>Fairy_Eyes</debugLabel>
                      <tagDef>Fairy_Eyes</tagDef>
                      <role>Eyes</role>
                      <texPath>Things/Pawn/FairyFestival/Parts/Eyes</texPath>
                      <useTransparentShader>true</useTransparentShader>
                      <baseLayer>8.3</baseLayer>
                    </li>
                    <li Class="LCAbnormalities.FairyFestival.PawnRenderNodeProperties_FairyFestivalPart">
                      <debugLabel>Fairy_Mouth</debugLabel>
                      <tagDef>Fairy_Mouth</tagDef>
                      <role>Mouth</role>
                      <texPath>Things/Pawn/FairyFestival/Parts/Mouth_Open</texPath>
                      <texPathAlt>Things/Pawn/FairyFestival/Parts/Mouth_Smile</texPathAlt>
                      <useTransparentShader>true</useTransparentShader>
                      <baseLayer>8.4</baseLayer>
                    </li>
                  </children>
                </li>

              </children>
            </li>
          </children>
        </li>
      </children>
    </root>
  </PawnRenderTreeDef>

</Defs>
