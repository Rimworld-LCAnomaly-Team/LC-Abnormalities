              <debugLabel>Chassis</debugLabel>
              <tagDef>WeCanChangeAnything_Chassis</tagDef>
              <role>Chassis</role>
              <useGraphic>false</useGraphic>
              <children>

                <!-- Clean spiked interior chamber -->
                <li Class="LCAbnormalities.WeCanChangeAnything.PawnRenderNodeProperties_WeCanChangeAnythingPart">
                  <debugLabel>Body</debugLabel>
                  <tagDef>WeCanChangeAnything_Body</tagDef>
                  <role>Body</role>
                  <texPath>Things/Building/WeCanChangeAnything/Parts/Body</texPath>
                  <baseLayer>8.0</baseLayer>
                </li>

                <!-- Blood-drenched gore interior (visible after a victim dies inside: End / Default_After / Start_After) -->
                <li Class="LCAbnormalities.WeCanChangeAnything.PawnRenderNodeProperties_WeCanChangeAnythingPart">
                  <debugLabel>BodyBlood</debugLabel>
                  <tagDef>WeCanChangeAnything_BodyBlood</tagDef>
