                  <debugLabel>Heart</debugLabel>
                  <tagDef>WeCanChangeAnything_Heart</tagDef>
                  <role>Heart</role>
                  <texPath>Things/Building/WeCanChangeAnything/Parts/Heart</texPath>
                  <useTransparentShader>true</useTransparentShader>
                  <baseLayer>10.6</baseLayer>
