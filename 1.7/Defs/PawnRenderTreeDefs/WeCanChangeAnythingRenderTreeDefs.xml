                <li Class="LCAbnormalities.WeCanChangeAnything.PawnRenderNodeProperties_WeCanChangeAnythingPart">
                  <debugLabel>Blood1</debugLabel>
                  <tagDef>WeCanChangeAnything_Blood1</tagDef>
