                <li Class="LCAbnormalities.WeCanChangeAnything.PawnRenderNodeProperties_WeCanChangeAnythingPart">
                  <debugLabel>DoorRight</debugLabel>
                  <tagDef>WeCanChangeAnything_DoorRight</tagDef>
                  <role>DoorRight</role>
                  <texPath>Things/Building/WeCanChangeAnything/Parts/DoorRight</texPath>
