<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="LC_EntityBase" Name="BaseBurrowingHeaven" Abstract="True">
    <thingClass>BurrowingHeaven.Things.LC_BurrowingHeavenPawn</thingClass>
    <statBases>
      <MoveSpeed>0</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
      <PsychicSensitivity>0</PsychicSensitivity>
      <LC_MinimumContainmentStrength>0</LC_MinimumContainmentStrength>
      <StaggerDurationFactor>0</StaggerDurationFactor>
      <ToxicResistance>1</ToxicResistance>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
    </statBases>
    <race>
      <body>BurrowingHeaven</body>
      <baseBodySize>2.5</baseBodySize>
      <baseHealthScale>4.0</baseHealthScale>
      <intelligence>ToolUser</intelligence>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <fleshType>LC_AbnormalityMechanical</fleshType>
      <foodType>None</foodType>
      <hasCorpse>false</hasCorpse>
      <lifeExpectancy>1000</lifeExpectancy>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <soundCallIntervalRange>120~240</soundCallIntervalRange>
      <disableIgniteVerb>true</disableIgniteVerb>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>LC_EntityFullyFormed</def>
          <soundDeath>BurrowingHeaven_Death</soundDeath>
        </li>
      </lifeStageAges>
      <hediffGiverSets>
      </hediffGiverSets>
    </race>
    <comps>
      <li Class="BurrowingHeaven.Comp.CompProperties_BurrowingHeaven">
        <qliphothCountMax>2</qliphothCountMax>
        <studySucessRateBase>0.2</studySucessRateBase>
        <shouldNotifyWhenEscape>true</shouldNotifyWhenEscape>
        <ifProvideWarningPoints>true</ifProvideWarningPoints>
        <customWarningPoints>-1</customWarningPoints>
        <soundWorking>BurrowingHeaven_loop</soundWorking>
        <workUnmonitoredGraceTicks>90</workUnmonitoredGraceTicks>
        <workUnmonitoredIntervalTicks>180</workUnmonitoredIntervalTicks>
        <workMeltdownStrikeDamage>35</workMeltdownStrikeDamage>
        <breachAttackWhileWatched>false</breachAttackWhileWatched>
        <breachTeleportOnUnwatched>true</breachTeleportOnUnwatched>
        <breachUnwatchedGraceTicks>90</breachUnwatchedGraceTicks>
        <breachUnwatchedBurstIntervalTicks>180</breachUnwatchedBurstIntervalTicks>
        <breachUnwatchedOutdoorRadius>18</breachUnwatchedOutdoorRadius>
        <breachUnwatchedBurstDamage>28</breachUnwatchedBurstDamage>
        <breachUnwatchedHealAmount>12</breachUnwatchedHealAmount>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <lookForTargetOnEscape>false</lookForTargetOnEscape>
        <hasAnimation>true</hasAnimation>
        <heldDrawScale>0.54</heldDrawScale>
        <heldDrawOffset>(0, 0, -0.35)</heldDrawOffset>
      </li>
      <li Class="BurrowingHeaven.Comp.CompProperties_Studiable_BurrowingHeaven">
        <frequencyTicks>60000</frequencyTicks>
        <studyTimesPeriod>1</studyTimesPeriod>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>WAW</abnormalityCategoryDef>
      </li>
    </modExtensions>
  </ThingDef>
  <!-- BurrowingHeaven Contained -->
  <ThingDef ParentName="BaseBurrowingHeaven">
    <defName>BurrowingHeaven</defName>
    <label>BurrowingHeaven</label>
    <description>The Burrowing Heaven (O-04-72) is an Abnormality similar in form to a tree, having a stalk coming from the floor and two skeletal wing-like extremities that branch into minor parts. Its main body is of a red color.\nIn the junction where the three main parts meet, it has a yellow eye with a red iris, as well as smaller eyes on other parts of its body.</description>
    <uiIconPath>UI/CodexEntries/BurrowingHeaven</uiIconPath>
    <race>
      <renderTree>BurrowingHeaven</renderTree>
      <thinkTreeMain>BurrowingHeaven</thinkTreeMain>
      <thinkTreeConstant>BurrowingHeavenConstant</thinkTreeConstant>
    </race>
    <comps>
      <li Class="LCAnomalyCore.Comp.CompProperties_PeBoxProduce">
        <peBoxDef>EnkephalinBox</peBoxDef>
        <amountProdueMax>18</amountProdueMax>
        <boxTexOffsetZ>0.0742</boxTexOffsetZ>
        <amountProdueRangeNormal>6~10</amountProdueRangeNormal>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_Accessoryable">
        <accessoryDef>Accessory_BurrowingHeaven</accessoryDef>
        <accessoryChance>0.04</accessoryChance>
        <unlockLevel>2</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_EgoExtractable">
        <weaponExtracted>EgoWeapon_BurrowingHeaven</weaponExtracted>
        <weaponIconPath>UI/Commands/ExtractEGO_BurrowingHeaven_Weapon</weaponIconPath>
        <amountMaxWeapon>1</amountMaxWeapon>
        <weaponExtractedNeed>45</weaponExtractedNeed>
        <armorExtracted>Apparel_BurrowingHeavenSuit</armorExtracted>
        <armorIconPath>UI/Commands/ExtractEGO_BurrowingHeaven_Armor</armorIconPath>
        <amountMaxArmor>3</amountMaxArmor>
        <armorExtractedNeed>30</armorExtractedNeed>
        <unlockLevel>3</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityStudyUnlocks">
        <studyNotes>
          <li>
            <threshold>6</threshold>
            <label>Observation Level: I</label>
            <text>Work with The Burrowing Heaven must be done while the manager has the Containment Unit in sight.\nSuccess Rate +4%</text>
          </li>
          <li>
            <threshold>8</threshold>
            <label>Observation Level: II</label>
            <text>During the work process, when the Containment Unit went out of the camera’s sight, the Qliphoth Counter lowered.\nWhen The Burrowing Heaven’s Containment Unit remained unmonitored after the phenomenon, the Counter continued to lower.\nWork Speed +4%\nUnlocks the E.G.O. Gift 'Heaven'.</text>
          </li>
          <li>
            <threshold>10</threshold>
            <label>Observation Level: III</label>
            <text>When the work result was Normal or Good, the Qliphoth Counter increased. It can increase by up to two levels on a Good result.\nSuccess Rate +4%\nUnlocks the E.G.O. Weapon and Suit 'Heaven'.</text>
          </li>
          <li>
            <threshold>12</threshold>
            <label>Observation Level: IV</label>
            <text>WARNING: Do not stop looking at the Abnormality while its suppression is in progress. Repression work yields the highest success rate, whereas Instinct work is completely futile.\nWork Speed +4%</text>
          </li>
        </studyNotes>
      </li>
    </comps>
  </ThingDef>
</Defs>
