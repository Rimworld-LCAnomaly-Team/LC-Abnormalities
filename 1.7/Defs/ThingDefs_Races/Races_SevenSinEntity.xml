  <!-- Melancholy -->
  <ThingDef ParentName="BaseSevenSinEntity">
    <defName>MelancholyEntity</defName>
    <label>Melancholy Entity</label>
    <description>An insect-like entity with a completely translucent body filled with stagnant water. Though organ-like structures float within, no biochemical reactions occur inside it—yet staring too long into its motionless depths threatens to drown the observer in sinking sorrow.</description>
