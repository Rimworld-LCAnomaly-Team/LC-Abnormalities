<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="LC_EntityBase" Name="BaseSevenSinEntity" Abstract="True">
    <thingClass>LC_SevenSin.Things.LC_SevenSinPawn</thingClass>
    <statBases>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <Flammability>1.25</Flammability>
      <MeatAmount>0</MeatAmount>
    </statBases>
    <race>
      <body>BaseSevenSinEntity</body>
      <baseBodySize>2</baseBodySize>
      <baseHealthScale>1</baseHealthScale>
      <lifeExpectancy>100</lifeExpectancy>
      <intelligence>ToolUser</intelligence>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <fleshType>LC_AbnormalityOrganic</fleshType>
      <foodType>None</foodType>
      <hasCorpse>true</hasCorpse>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <soundCallIntervalRange>120~240</soundCallIntervalRange>
      <disableIgniteVerb>true</disableIgniteVerb>
      <trainability>None</trainability>
      <isImmuneToInfections>true</isImmuneToInfections>
      <bleedRateFactor>0.5</bleedRateFactor>
      <hediffGiverSets>
      </hediffGiverSets>
      <corpseHiddenWhileUndiscovered>false</corpseHiddenWhileUndiscovered>
      <lifeStageAges>
        <li>
          <def>LC_EntityFullyFormed</def>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
        </li>
      </lifeStageAges>
      <deathAction Class="DeathActionProperties_Vanish">
        <workerClass>DeathActionWorker_Vanish</workerClass>
        <filth>Filth_Blood</filth>
        <filthCountRange>1~3</filthCountRange>
        <meatExplosionSize>Small</meatExplosionSize>
      </deathAction>
    </race>
    <comps>
      <li Class="LCAnomalyCore.Comp.CompProperties_PeBoxProduce">
        <peBoxDef>EnkephalinBox</peBoxDef>
        <amountProdueRangeNormal>4~7</amountProdueRangeNormal>
        <amountProdueMax>10</amountProdueMax>
        <boxTexOffsetZ>0.178</boxTexOffsetZ>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <lookForTargetOnEscape>true</lookForTargetOnEscape>
        <hasAnimation>false</hasAnimation>
      </li>
      <li Class="CompProperties_AttachPoints">
        <points>
          <li>
            <offset>(-.35, 0, .35)</offset>
            <type>PlatformRestraint0</type>
          </li>
          <li>
            <offset>(.35, 0, .35)</offset>
            <type>PlatformRestraint1</type>
          </li>
          <li>
            <offset>(.2, 0, -.71)</offset>
            <type>PlatformRestraint2</type>
          </li>
          <li>
            <offset>(-.2, 0, -.71)</offset>
            <type>PlatformRestraint3</type>
          </li>
        </points>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityStudiable">
        <frequencyTicks>60000</frequencyTicks>
        <studyTimesPeriod>1</studyTimesPeriod>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityStudyUnlocks">
        <studyNotes>
          <li>
            <threshold>4</threshold>
            <label>Observation Level: I</label>
            <text>These lesser distortions emerge from unstable Cogito injections. When dropped outside a containment platform, a Peccatulum immediately attempts to breach.\nSuccess Rate +4%</text>
          </li>
          <li>
            <threshold>8</threshold>
            <label>Observation Level: II</label>
            <text>Each Peccatulum manifests a distinct elemental affinity and sin temperament—ranging from physical brutality (Wrath, Sloth, Pride) to mental or erosive attacks (Melancholy, Gluttony).\nWork Speed +4%</text>
          </li>
        </studyNotes>
      </li>
    </comps>
    <tools>
      <li>
        <label>spike</label>
        <labelNoLocation>spike</labelNoLocation>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LC_MiddleSpike</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <chanceFactor>0.5</chanceFactor>
        <soundMeleeHit>Pawn_Melee_HumanBite_Hit</soundMeleeHit>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
        <soundMeleeHit>Pawn_Melee_Punch_HitPawn</soundMeleeHit>
      </li>
    </tools>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>ZAYIN</abnormalityCategoryDef>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Gluttony -->
  <ThingDef ParentName="BaseSevenSinEntity">
    <defName>GluttonyEntity</defName>
    <label>Gluttony Entity</label>
    <description>It happened while passing through a lush, green jungle teeming with strange flora and butterflies. Normally, a plant takes root and spends its whole life in one spot, yet these mobile botanical beasts tore their roots free like limbs and hunted with fanged blossoms, endlessly stuffing prey into bodies that cannot store nourishment.</description>
    <uiIconPath>UI/CodexEntries/GluttonyEntity</uiIconPath>
    <race>
      <renderTree>Animal</renderTree>
      <thinkTreeMain>LC_FeralAbnormality</thinkTreeMain>
      <thinkTreeConstant>LC_AbnormalityConstant</thinkTreeConstant>
    </race>
    <comps>
      <li Class="LC_SevenSin.Comp.CompProperties_SevenSinEntity">
        <qliphothCountMax>3</qliphothCountMax>
        <studySucessRateBase>0.8</studySucessRateBase>
        <shouldNotifyWhenEscape>true</shouldNotifyWhenEscape>
        <ifProvideWarningPoints>true</ifProvideWarningPoints>
        <customWarningPoints>-1</customWarningPoints>
        <instinctBonus>0.75</instinctBonus>
        <insightBonus>0.65</insightBonus>
        <attachmentBonus>0.60</attachmentBonus>
        <repressionBonus>0.65</repressionBonus>
      </li>
    </comps>
    <killedLeavingsRanges>
      <GluttonyDead>1</GluttonyDead>
    </killedLeavingsRanges>
    <descriptionHyperlinks>
      <ThingDef>GluttonyDead</ThingDef>
    </descriptionHyperlinks>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.FourColorTargetExtension">
        <targetKind>Abnormality</targetKind>
        <redResistance>1.0</redResistance>
        <whiteResistance>1.0</whiteResistance>
        <blackResistance>0.7</blackResistance>
        <paleResistance>1.5</paleResistance>
      </li>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>Black</damageType>
        <riskLevel>ZAYIN</riskLevel>
        <damageMultiplier>1.0</damageMultiplier>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Lust -->
  <ThingDef ParentName="BaseSevenSinEntity">
    <defName>LustEntity</defName>
    <label>Lust Entity</label>
    <description>At first glance it resembles a writhing heap of grotesque flesh, until its maw opens—revealing two twisted arms intertwined like a tongue, clutching a glaring eye within. Though silent, its ravenous gaze makes clear it still hungers to devour more living tissue.</description>
