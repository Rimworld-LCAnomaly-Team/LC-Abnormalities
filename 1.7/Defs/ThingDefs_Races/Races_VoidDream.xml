<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_EntityBase">
    <defName>VoidDream</defName>
    <label>Void Dream</label>
    <description>A drowsy violet dream-sheep (T-02-99) whose fluffy wool conceals glowing emerald and magenta eyes.\n\nIf an undisciplined agent (Temperance I) dares tend it, its Qliphoth Counter drops. When breached, it drifts peacefully as a floating sheep launching hypnotic dream orbs—if left unharmed it eventually returns to its egg, but attacking it triggers a wool-cloud metamorphosis into a towering rooster whose multi-pulse hypnotic crow plunges nearby humans into a fatal nightmare slumber.</description>
    <uiIconPath>UI/CodexEntries/VoidDream</uiIconPath>
    <thingClass>LCAbnormalities.VoidDream.LC_VoidDreamPawn</thingClass>
    <statBases>
      <MoveSpeed>3.4</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
      <PsychicSensitivity>0</PsychicSensitivity>
      <LC_MinimumContainmentStrength>30</LC_MinimumContainmentStrength>
      <StaggerDurationFactor>0</StaggerDurationFactor>
      <ToxicResistance>1</ToxicResistance>
    </statBases>
    <race>
      <body>OneSin</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>2.2</baseHealthScale>
      <intelligence>ToolUser</intelligence>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <fleshType>LC_AbnormalityOrganic</fleshType>
      <foodType>None</foodType>
      <hasCorpse>false</hasCorpse>
      <lifeExpectancy>1000</lifeExpectancy>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <disableIgniteVerb>true</disableIgniteVerb>
      <trainability>None</trainability>
      <renderTree>VoidDream</renderTree>
      <thinkTreeMain>VoidDreamMain</thinkTreeMain>
      <thinkTreeConstant>LC_AbnormalityConstant</thinkTreeConstant>
      <lifeStageAges>
        <li>
          <def>LC_EntityFullyFormed</def>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>dream beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="LCAbnormalities.VoidDream.CompProperties_VoidDream">
        <qliphothCountMax>2</qliphothCountMax>
        <studySucessRateBase>0.0</studySucessRateBase>
        <shouldNotifyWhenEscape>true</shouldNotifyWhenEscape>
        <ifProvideWarningPoints>true</ifProvideWarningPoints>
        <customWarningPoints>-1</customWarningPoints>
        <soundWorking>LC_VoidDream_WorkLoop</soundWorking>
        <allowRoamingOutsideContainment>true</allowRoamingOutsideContainment>
        <canWanderInContainmentRoom>false</canWanderInContainmentRoom>
        <crowIntervalTicks>420</crowIntervalTicks>
        <crowRadius>10</crowRadius>
        <orbIntervalTicks>210</orbIntervalTicks>
        <orbRange>14</orbRange>
        <orbVolleyCount>4</orbVolleyCount>
        <sheepCalmReturnTicks>3600</sheepCalmReturnTicks>
        <dyingFxDef>DyingVoidDream</dyingFxDef>
        <workDamageDef>LC_BlackDamage</workDamageDef>
        <workDamageRange>1~3</workDamageRange>
        <escapedLetterLabelKey>LC_VoidDream_EscapedLabel</escapedLetterLabelKey>
        <escapedLetterTextKey>LC_VoidDream_EscapedText</escapedLetterTextKey>
        <killedLetterLabelKey>LC_VoidDream_KilledLabel</killedLetterLabelKey>
        <killedLetterTextKey>LC_VoidDream_KilledText</killedLetterTextKey>
        <instinctProbs>
          <li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li>
        </instinctProbs>
        <insightProbs>
          <li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li>
        </insightProbs>
        <attachmentProbs>
          <li>0.60</li><li>0.60</li><li>0.60</li><li>0.60</li><li>0.60</li>
        </attachmentProbs>
        <repressionProbs>
          <li>0.20</li><li>0.20</li><li>0.20</li><li>0.20</li><li>0.20</li>
        </repressionProbs>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <lookForTargetOnEscape>true</lookForTargetOnEscape>
        <hasAnimation>true</hasAnimation>
      </li>
      <li Class="LCAbnormalities.Shared.CompProperties_Studiable_LCBonus">
        <frequencyTicks>60000</frequencyTicks>
        <studyTimesPeriod>1</studyTimesPeriod>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
        <speedOffsetsByProgress>
          <li>0</li><li>0.03</li><li>0.05</li><li>0.07</li><li>0.10</li>
        </speedOffsetsByProgress>
        <successOffsetsByProgress>
          <li>0</li><li>0.03</li><li>0.05</li><li>0.07</li><li>0.10</li>
        </successOffsetsByProgress>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_PeBoxProduce">
        <peBoxDef>EnkephalinBox</peBoxDef>
        <amountProdueRangeNormal>7~8</amountProdueRangeNormal>
        <amountProdueMax>14</amountProdueMax>
        <boxTexOffsetZ>0.126</boxTexOffsetZ>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_Accessoryable">
        <accessoryDef>Accessory_VoidDream</accessoryDef>
        <accessoryChance>0.05</accessoryChance>
        <unlockLevel>2</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_EgoExtractable">
        <weaponExtracted>EgoWeapon_VoidDream</weaponExtracted>
        <weaponIconPath>UI/Commands/ExtractEGO_VoidDream_Weapon</weaponIconPath>
        <amountMaxWeapon>3</amountMaxWeapon>
        <weaponExtractedNeed>24</weaponExtractedNeed>
        <armorExtracted>Apparel_VoidDreamSuit</armorExtracted>
        <armorIconPath>UI/Commands/ExtractEGO_VoidDream_Armor</armorIconPath>
        <amountMaxArmor>3</amountMaxArmor>
        <armorExtractedNeed>18</armorExtractedNeed>
        <unlockLevel>3</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityStudyUnlocks">
        <studyNotes>
          <li>
            <threshold>2</threshold>
            <label>Observation Level: I</label>
            <text>Never send an agent at Temperance I or lower; Void Dream grows restless and drops its Qliphoth Counter (Max 2).</text>
          </li>
          <li>
            <threshold>5</threshold>
            <label>Observation Level: II</label>
            <text>When Void Dream breaches, it floats as a sheep launching hypnotic light orbs (and returns peacefully if left unharmed for 60s). Attacking it triggers a wool-cloud transformation into a grotesque rooster whose periodic crow puts nearby humans to sleep.\nUnlocks the E.G.O. Gift 'Engulfing Dream'.</text>
          </li>
          <li>
            <threshold>9</threshold>
            <label>Observation Level: III</label>
            <text>Select any sleeping victim and click "Wake Sleeper" within 60 seconds—before nightmare shock or a second crow claims their sanity.\nUnlocks the TETH E.G.O. Weapon and Suit 'Engulfing Dream'.</text>
          </li>
          <li>
            <threshold>13</threshold>
            <label>Observation Level: IV</label>
            <text>Attachment work reliably yields positive results while keeping this eerie shepherd asleep.\nWork Speed +10% &amp; Success Rate +10%.</text>
          </li>
        </studyNotes>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>TETH</abnormalityCategoryDef>
      </li>
      <li Class="LCAnomalyCore.ModExtensions.FourColorTargetExtension">
        <targetKind>Abnormality</targetKind>
        <redResistance>1.5</redResistance>
        <whiteResistance>0.8</whiteResistance>
        <blackResistance>1.2</blackResistance>
        <paleResistance>2.0</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
