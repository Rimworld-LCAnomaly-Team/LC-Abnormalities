<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_EntityBase">
    <defName>ScorchedGirl</defName>
    <label>Scorched Girl</label>
    <description>The charred, tearful silhouette of a girl pierced by a massive matchstick (F-01-02).\n\nNormal work has a 50% chance to drop her Qliphoth Counter (Max 2), and Bad work always drops it. Upon breaching, her match ignites for a 20-second sprint toward the nearest human—detonating in a violent fiery Red explosion unless suppressed before she closes in.</description>
    <uiIconPath>UI/CodexEntries/ScorchedGirl</uiIconPath>
    <thingClass>LCAbnormalities.ScorchedGirl.LC_ScorchedGirlPawn</thingClass>
    <statBases>
      <MoveSpeed>4.4</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>200</ComfyTemperatureMax>
      <PsychicSensitivity>0</PsychicSensitivity>
      <LC_MinimumContainmentStrength>35</LC_MinimumContainmentStrength>
      <StaggerDurationFactor>0</StaggerDurationFactor>
      <ToxicResistance>1</ToxicResistance>
    </statBases>
    <race>
      <body>OneSin</body>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>2.4</baseHealthScale>
      <intelligence>ToolUser</intelligence>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <fleshType>LC_AbnormalityOrganic</fleshType>
      <foodType>None</foodType>
      <hasCorpse>false</hasCorpse>
      <lifeExpectancy>1000</lifeExpectancy>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <disableIgniteVerb>true</disableIgniteVerb>
      <trainability>None</trainability>
      <renderTree>ScorchedGirl</renderTree>
      <thinkTreeMain>ScorchedGirlMain</thinkTreeMain>
      <thinkTreeConstant>LC_AbnormalityConstant</thinkTreeConstant>
      <lifeStageAges>
        <li>
          <def>LC_EntityFullyFormed</def>
          <soundDeath>LC_ScorchedGirl_Death</soundDeath>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>ember punch</label>
        <capacities><li>Blunt</li></capacities>
        <power>8</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="LCAbnormalities.ScorchedGirl.CompProperties_ScorchedGirl">
        <qliphothCountMax>2</qliphothCountMax>
        <studySucessRateBase>0.0</studySucessRateBase>
        <shouldNotifyWhenEscape>true</shouldNotifyWhenEscape>
        <ifProvideWarningPoints>true</ifProvideWarningPoints>
        <customWarningPoints>-1</customWarningPoints>
        <soundWorking>LC_ScorchedGirl_WorkLoop</soundWorking>
        <allowRoamingOutsideContainment>true</allowRoamingOutsideContainment>
        <canWanderInContainmentRoom>false</canWanderInContainmentRoom>
        <dyingFxDef>DyingScorchedGirl</dyingFxDef>
        <workDamageDef>LC_RedDamage</workDamageDef>
        <workDamageRange>2~4</workDamageRange>
        <escapedLetterLabelKey>LC_ScorchedGirl_EscapedLabel</escapedLetterLabelKey>
        <escapedLetterTextKey>LC_ScorchedGirl_EscapedText</escapedLetterTextKey>
        <killedLetterLabelKey>LC_ScorchedGirl_KilledLabel</killedLetterLabelKey>
        <killedLetterTextKey>LC_ScorchedGirl_KilledText</killedLetterTextKey>
        <instinctProbs>
          <li>0.40</li><li>0.40</li><li>0.40</li><li>0.40</li><li>0.40</li>
        </instinctProbs>
        <insightProbs>
          <li>0.60</li><li>0.60</li><li>0.50</li><li>0.50</li><li>0.50</li>
        </insightProbs>
        <attachmentProbs>
          <li>0.30</li><li>0.15</li><li>0.0</li><li>0.0</li><li>0.0</li>
        </attachmentProbs>
        <repressionProbs>
          <li>0.50</li><li>0.50</li><li>0.40</li><li>0.40</li><li>0.40</li>
        </repressionProbs>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <lookForTargetOnEscape>true</lookForTargetOnEscape>
        <hasAnimation>true</hasAnimation>
        <heldDrawScale>0.92</heldDrawScale>
        <heldDrawOffset>(0, 0, -0.02)</heldDrawOffset>
      </li>
      <li Class="LCAbnormalities.Shared.CompProperties_Studiable_LCBonus">
        <frequencyTicks>60000</frequencyTicks>
        <studyTimesPeriod>1</studyTimesPeriod>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
        <speedOffsetsByProgress>
          <li>0</li><li>0.03</li><li>0.05</li><li>0.07</li><li>0.10</li>
        </speedOffsetsByProgress>
        <successOffsetsByProgress>
          <li>0</li><li>0.03</li><li>0.05</li><li>0.07</li><li>0.10</li>
        </successOffsetsByProgress>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_PeBoxProduce">
        <peBoxDef>EnkephalinBox</peBoxDef>
        <amountProdueRangeNormal>5~7</amountProdueRangeNormal>
        <amountProdueMax>12</amountProdueMax>
        <boxTexOffsetZ>0.147</boxTexOffsetZ>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_Accessoryable">
        <accessoryDef>Accessory_ScorchedGirl</accessoryDef>
        <accessoryChance>0.05</accessoryChance>
        <unlockLevel>2</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_EgoExtractable">
        <weaponExtracted>EgoWeapon_ScorchedGirl</weaponExtracted>
        <weaponIconPath>UI/Commands/ExtractEGO_ScorchedGirl_Weapon</weaponIconPath>
        <amountMaxWeapon>3</amountMaxWeapon>
        <weaponExtractedNeed>22</weaponExtractedNeed>
        <armorExtracted>Apparel_ScorchedGirlSuit</armorExtracted>
        <armorIconPath>UI/Commands/ExtractEGO_ScorchedGirl_Armor</armorIconPath>
        <amountMaxArmor>3</amountMaxArmor>
        <armorExtractedNeed>16</armorExtractedNeed>
        <unlockLevel>3</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityStudyUnlocks">
        <studyNotes>
          <li>
            <threshold>2</threshold>
            <label>Observation Level: I</label>
            <text>Avoid Attachment—at level III+ Temperance, Attachment drops to 0%. Prefer Insight and Repression to keep her calm.</text>
          </li>
          <li>
            <threshold>5</threshold>
            <label>Observation Level: II</label>
            <text>Normal work carries a 50% chance to lower her Qliphoth Counter (Max 2), and Bad work always drops it.\nUnlocks the E.G.O. Gift 'Fourth Match Flame'.</text>
          </li>
          <li>
            <threshold>9</threshold>
            <label>Observation Level: III</label>
            <text>When Scorched Girl breaches, she rushes the nearest human with a 20-second fuse. Shoot her down from range before she gets close—or suffer a 38-Red blast!\nUnlocks the TETH E.G.O. Cannon and Suit 'Fourth Match Flame'.</text>
          </li>
          <li>
            <threshold>13</threshold>
            <label>Observation Level: IV</label>
            <text>Once suppressed before detonation, she returns harmlessly as an egg—though ash never fades for long.\nWork Speed +10% &amp; Success Rate +10%.</text>
          </li>
        </studyNotes>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>TETH</abnormalityCategoryDef>
      </li>
      <li Class="LCAnomalyCore.ModExtensions.FourColorTargetExtension">
        <targetKind>Abnormality</targetKind>
        <redResistance>0.5</redResistance>
        <whiteResistance>2.0</whiteResistance>
        <blackResistance>1.0</blackResistance>
        <paleResistance>2.0</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
