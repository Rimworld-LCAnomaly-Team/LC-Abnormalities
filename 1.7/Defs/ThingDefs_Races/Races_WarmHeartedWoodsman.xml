<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="LC_EntityBase">
    <defName>WarmHeartedWoodsman</defName>
    <label>Warm-Hearted Woodsman</label>
    <description>A hulking moss-coated tin woodsman driven by a furnace compartment in its torso that forever craves a beating human heart (F-05-32).\n\nBoth Bad results and overly kind employees with Temperance Level III or above reduce its Qliphoth Counter (max 1). Crucially, reaching 0 does NOT cause an immediate breach—instead, the Woodsman remains deceptively still until the next unfortunate worker walks inside, executing them and stuffing their heart into its furnace before bursting loose. During a breach, it feasts on fallen humanlike corpses to mend its iron hull.</description>
    <uiIconPath>UI/CodexEntries/WarmHeartedWoodsman</uiIconPath>
    <thingClass>LCAbnormalities.WarmHeartedWoodsman.LC_WarmHeartedWoodsmanPawn</thingClass>
    <statBases>
      <MoveSpeed>2.9</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-200</ComfyTemperatureMin>
      <ComfyTemperatureMax>150</ComfyTemperatureMax>
      <PsychicSensitivity>0</PsychicSensitivity>
      <LC_MinimumContainmentStrength>55</LC_MinimumContainmentStrength>
      <StaggerDurationFactor>0.10</StaggerDurationFactor>
      <ToxicResistance>1</ToxicResistance>
    </statBases>
    <tools>
      <li>
        <label>bloody logging axe</label>
        <capacities><li>LC_WoodsmanBreachAxe</li></capacities>
        <power>24</power>
        <cooldownTime>1.85</cooldownTime>
        <soundMeleeHit>LC_Woodsman_AxeHit</soundMeleeHit>
      </li>
    </tools>
    <race>
      <body>OneSin</body>
      <baseBodySize>1.55</baseBodySize>
      <baseHealthScale>6.2</baseHealthScale>
      <intelligence>ToolUser</intelligence>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <fleshType>LC_AbnormalityOrganic</fleshType>
      <foodType>None</foodType>
      <hasCorpse>false</hasCorpse>
      <lifeExpectancy>1000</lifeExpectancy>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <disableIgniteVerb>true</disableIgniteVerb>
      <trainability>None</trainability>
      <renderTree>WarmHeartedWoodsman</renderTree>
      <thinkTreeMain>WarmHeartedWoodsmanMain</thinkTreeMain>
      <thinkTreeConstant>LC_AbnormalityConstant</thinkTreeConstant>
      <lifeStageAges>
        <li>
          <def>LC_EntityFullyFormed</def>
        </li>
      </lifeStageAges>
    </race>
    <comps>
      <li Class="LCAbnormalities.WarmHeartedWoodsman.CompProperties_WarmHeartedWoodsman">
        <qliphothCountMax>1</qliphothCountMax>
        <studySucessRateBase>0.0</studySucessRateBase>
        <shouldNotifyWhenEscape>true</shouldNotifyWhenEscape>
        <ifProvideWarningPoints>true</ifProvideWarningPoints>
        <customWarningPoints>-1</customWarningPoints>
        <allowRoamingOutsideContainment>true</allowRoamingOutsideContainment>
        <dyingFxDef>DyingWarmHeartedWoodsman</dyingFxDef>
        <workDamageDef>LC_WhiteDamage</workDamageDef>
        <workDamageRange>3~5</workDamageRange>
        <escapedLetterLabelKey>LC_Woodsman_EscapedLabel</escapedLetterLabelKey>
        <escapedLetterTextKey>LC_Woodsman_EscapedText</escapedLetterTextKey>
        <killedLetterLabelKey>LC_Woodsman_SuppressedLabel</killedLetterLabelKey>
        <killedLetterTextKey>LC_Woodsman_SuppressedText</killedLetterTextKey>
        <instinctProbs>
          <li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li>
        </instinctProbs>
        <insightProbs>
          <li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li>
        </insightProbs>
        <attachmentProbs>
          <li>0.50</li><li>0.60</li><li>0.70</li><li>0.80</li><li>0.90</li>
        </attachmentProbs>
        <repressionProbs>
          <li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li><li>0.45</li>
        </repressionProbs>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <lookForTargetOnEscape>true</lookForTargetOnEscape>
        <hasAnimation>true</hasAnimation>
        <heldDrawScale>1.0</heldDrawScale>
        <heldDrawOffset>(0, 0, -0.05)</heldDrawOffset>
      </li>
      <li Class="LCAbnormalities.Shared.CompProperties_Studiable_LCBonus">
        <frequencyTicks>60000</frequencyTicks>
        <studyTimesPeriod>1</studyTimesPeriod>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
        <speedOffsetsByProgress>
          <li>0</li><li>0.04</li><li>0.04</li><li>0.08</li><li>0.08</li>
        </speedOffsetsByProgress>
        <successOffsetsByProgress>
          <li>0</li><li>0.04</li><li>0.04</li><li>0.08</li><li>0.08</li>
        </successOffsetsByProgress>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_PeBoxProduce">
        <peBoxDef>EnkephalinBox</peBoxDef>
        <amountProdueRangeNormal>8~14</amountProdueRangeNormal>
        <amountProdueMax>18</amountProdueMax>
        <boxTexOffsetZ>0.0742</boxTexOffsetZ>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_Accessoryable">
        <accessoryDef>Accessory_WarmHeartedWoodsman</accessoryDef>
        <accessoryChance>0.04</accessoryChance>
        <unlockLevel>2</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_EgoExtractable">
        <weaponExtracted>EgoWeapon_WarmHeartedWoodsman</weaponExtracted>
        <weaponIconPath>UI/Commands/ExtractEGO_WarmHeartedWoodsman_Weapon</weaponIconPath>
        <amountMaxWeapon>2</amountMaxWeapon>
        <weaponExtractedNeed>40</weaponExtractedNeed>
        <armorExtracted>Apparel_WarmHeartedWoodsmanSuit</armorExtracted>
        <armorIconPath>UI/Commands/ExtractEGO_WarmHeartedWoodsman_Armor</armorIconPath>
        <amountMaxArmor>3</amountMaxArmor>
        <armorExtractedNeed>30</armorExtractedNeed>
        <unlockLevel>3</unlockLevel>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityStudyUnlocks">
        <studyNotes>
          <li>
            <threshold>3</threshold>
            <label>Observation Level: I</label>
            <text>Managerial Tip 1: When work yields a Bad result, the Qliphoth Counter (max 1) drops.\nStrong vs White/Black (0.8), weak vs Red (1.5).</text>
          </li>
          <li>
            <threshold>7</threshold>
            <label>Observation Level: II</label>
            <text>Managerial Tip 2: Whenever an employee with Temperance Level III or higher finishes working with it, the Qliphoth Counter drops.\nUnlocks the E.G.O. Gift 'Logging'.</text>
          </li>
          <li>
            <threshold>12</threshold>
            <label>Observation Level: III</label>
            <text>Managerial Tip 3: At Qliphoth 0 it waits silently instead of breaching at once. The very next employee who enters is executed for their heart before it breaks loose.</text>
          </li>
          <li>
            <threshold>18</threshold>
            <label>Observation Level: IV</label>
            <text>When escaping, it crushes nearby foes with heavy Red axe blows and consumes fallen humanlike corpses to heal ~95 HP.\nUnlocks the HE E.G.O. Great Axe 'Logging' and Suit.</text>
          </li>
        </studyNotes>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>HE</abnormalityCategoryDef>
      </li>
      <li Class="LCAnomalyCore.ModExtensions.FourColorTargetExtension">
        <targetKind>Abnormality</targetKind>
        <redResistance>1.5</redResistance>
        <whiteResistance>0.8</whiteResistance>
        <blackResistance>0.8</blackResistance>
        <paleResistance>1.0</paleResistance>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
