<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Whirlwind_OmNomNom -->
  <AbilityDef ParentName="AbilityTouchBase">
    <defName>Whirlwind_OmNomNom</defName>
    <label>Whirlwind Om-Nom-Nom!</label>
    <description>Maul a living or mechanical target with a heavy Black bite.\nAgainst non-mechanoids, also briefly stuns the target and heals one of the wielder's injuries.</description>
    <iconPath>UI/WeaponSkills/MeatLantern/Whirlwind_OmNomNom</iconPath>
    <cooldownTicksRange>900</cooldownTicksRange>
    <displayOrder>100</displayOrder>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <drawAimPie>false</drawAimPie>
      <range>-1</range>
      <requireLineOfSight>true</requireLineOfSight>
      <warmupTime>0.01</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MeatLantern.Comp.CompProperties_AbilityWhirlwindOmNomNom">
        <damageRange>16~24</damageRange>
        <armorPenetration>0.3</armorPenetration>
        <suckPercent>0.5</suckPercent>
        <stunPercent>0.2</stunPercent>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>BloodSplash</fleckDef>
      </li>
    </comps>
  </AbilityDef>

</Defs>
