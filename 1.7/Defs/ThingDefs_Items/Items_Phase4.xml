<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <LCAnomalyCore.Defs.ThingDef_AbnormalityEgg ParentName="ResourceBase">
    <defName>PpodaeEgg</defName>
    <label>Ppodae Egg</label>
    <description>The ribbon-warmed stasis egg of Ppodae (D-02-107).</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Special/PpodaeEgg</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <genericMarketSellable>false</genericMarketSellable>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <MarketValue>0</MarketValue>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
      <LC_MinimumContainmentStrength>35</LC_MinimumContainmentStrength>
    </statBases>
    <thingCategories><li>LC_Entity_Egg</li></thingCategories>
    <descriptionHyperlinks><PawnKindDef>Ppodae</PawnKindDef></descriptionHyperlinks>
    <hiddenWhileUndiscovered>false</hiddenWhileUndiscovered>
    <comps>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <heldPawnKind>Ppodae</heldPawnKind>
        <capturedLetterLabel>Ppodae Contained</capturedLetterLabel>
        <capturedLetterText>{PAWN_nameDef} placed the Ppodae egg onto the holding platform, where a tiny white puppy now wags its tail for Instinct treats.</capturedLetterText>
      </li>
      <li Class="CompProperties_Usable">
        <useJob>SmashThing</useJob>
        <useLabel>Smash {0_label}</useLabel>
        <useMessage>{PAWN_nameDef} smashed the Ppodae egg into Enkephalin Boxes.</useMessage>
        <useDuration>300</useDuration>
      </li>
      <li Class="CompProperties_UseEffectPlaySound"><soundOnUsed>ChunkRock_Drop</soundOnUsed></li>
      <li Class="CompProperties_UseEffectDestroySelf"><leavings><EnkephalinBox>12</EnkephalinBox></leavings></li>
      <li Class="LCAnomalyCore.Comp.CompProperties_Abnormality" />
      <li Class="LCAnomalyCore.Comp.LC_CompProperties_InteractableEgg">
        <compClass>LCAnomalyCore.Comp.LC_CompEgg</compClass>
        <ticksToActivate>0</ticksToActivate>
        <activateTexPath>UI/Commands/SmashPpodaeEgg</activateTexPath>
        <activateLabelString>Smash...</activateLabelString>
        <activateDescString>Smash the Ppodae egg.</activateDescString>
        <activatingStringPending>smashing Ppodae egg</activatingStringPending>
        <guiLabelString>Choose who should do this</guiLabelString>
        <showMustBeActivatedByColonist>false</showMustBeActivatedByColonist>
        <shouldTransferBioSignature>true</shouldTransferBioSignature>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>TETH</abnormalityCategoryDef>
      </li>
    </modExtensions>
  </LCAnomalyCore.Defs.ThingDef_AbnormalityEgg>

