<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <LCAnomalyCore.Defs.ThingDef_AbnormalityEgg ParentName="ResourceBase">
    <defName>NothingThereEgg</defName>
    <label>Nothing There Egg</label>
    <description>The dormant flesh cocoon of an ALEPH Abnormality after suppression, quivering faintly with three unblinking eyes.</description>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>ALEPH</abnormalityCategoryDef>
      </li>
    </modExtensions>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Special/NothingThereEgg</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <genericMarketSellable>false</genericMarketSellable>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <MarketValue>0</MarketValue>
      <Mass>8</Mass>
      <Flammability>0</Flammability>
      <LC_MinimumContainmentStrength>0</LC_MinimumContainmentStrength>
    </statBases>
    <thingCategories>
      <li>LC_Entity_Egg</li>
    </thingCategories>
    <descriptionHyperlinks>
      <PawnKindDef>NothingThere</PawnKindDef>
    </descriptionHyperlinks>
    <hiddenWhileUndiscovered>false</hiddenWhileUndiscovered>
    <comps>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <heldPawnKind>NothingThere</heldPawnKind>
        <capturedLetterLabel>Nothing There Contained</capturedLetterLabel>
        <capturedLetterText>After {PAWN_nameDef} bound the Nothing There egg to the holding platform, the writhing flesh condensed into containment once more.\nOnly high-Fortitude, high-Justice agents should ever enter its chamber.</capturedLetterText>
      </li>
      <li Class="CompProperties_AttachPoints">
        <points>
          <li>
            <offset>(-.25, 0, .25)</offset>
            <type>PlatformRestraint0</type>
          </li>
          <li>
            <offset>(.25, 0, .25)</offset>
            <type>PlatformRestraint1</type>
          </li>
          <li>
            <offset>(.25, 0, -.25)</offset>
            <type>PlatformRestraint2</type>
          </li>
          <li>
            <offset>(-.25, 0, -.25)</offset>
            <type>PlatformRestraint3</type>
          </li>
        </points>
      </li>
      <li Class="CompProperties_Usable">
        <useJob>SmashThing</useJob>
        <useLabel>Smash {0_label}</useLabel>
        <useMessage>{PAWN_nameDef} smashed the Nothing There egg, dissolving its dense flesh into PE-Boxes.</useMessage>
        <useDuration>360</useDuration>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>BulletImpact_Flesh</soundOnUsed>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf">
        <leavings>
          <EnkephalinBox>40</EnkephalinBox>
        </leavings>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_Abnormality" />
      <li Class="LCAnomalyCore.Comp.LC_CompProperties_InteractableEgg">
        <compClass>LCAnomalyCore.Comp.LC_CompEgg</compClass>
        <ticksToActivate>0</ticksToActivate>
        <activateTexPath>UI/Commands/SmashNothingThereEgg</activateTexPath>
        <activateLabelString>Smash...</activateLabelString>
        <activateDescString>Smash the Nothing There egg to harvest Enkephalin PE-Boxes.</activateDescString>
        <activatingStringPending>smashing Nothing There egg</activatingStringPending>
        <guiLabelString>Choose who should do this</guiLabelString>
        <showMustBeActivatedByColonist>false</showMustBeActivatedByColonist>
        <shouldTransferBioSignature>true</shouldTransferBioSignature>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
  </LCAnomalyCore.Defs.ThingDef_AbnormalityEgg>

</Defs>
