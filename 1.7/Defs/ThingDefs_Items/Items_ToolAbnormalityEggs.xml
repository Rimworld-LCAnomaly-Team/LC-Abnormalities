<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- O-09-91 Portrait of Another World Egg -->
  <LCAnomalyCore.Defs.ThingDef_AbnormalityEgg ParentName="ResourceBase">
    <defName>PortraitOfAnotherWorldEgg</defName>
    <label>Portrait of Another World Egg</label>
    <description>The sealed stasis pod of Portrait of Another World (O-09-91). Bind it to a Holding Platform to deploy the tool abnormality for colonist use, or smash it to harvest Enkephalin Boxes.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Special/PortraitOfAnotherWorldEgg</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <genericMarketSellable>false</genericMarketSellable>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <MarketValue>0</MarketValue>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
      <LC_MinimumContainmentStrength>0</LC_MinimumContainmentStrength>
    </statBases>
    <thingCategories>
      <li>LC_Entity_Egg</li>
    </thingCategories>
    <descriptionHyperlinks>
      <PawnKindDef>PortraitOfAnotherWorld</PawnKindDef>
    </descriptionHyperlinks>
    <hiddenWhileUndiscovered>false</hiddenWhileUndiscovered>
    <comps>
      <li Class="LCAnomalyCore.Comp.CompProperties_AbnormalityHoldingPlatformTarget">
        <heldPawnKind>PortraitOfAnotherWorld</heldPawnKind>
        <capturedLetterLabel>Portrait of Another World Contained</capturedLetterLabel>
        <capturedLetterText>{PAWN_nameDef} secured the Portrait of Another World egg onto a holding platform, materializing the portrait inside.</capturedLetterText>
      </li>
      <li Class="CompProperties_Usable">
        <useJob>SmashThing</useJob>
        <useLabel>Smash {0_label}</useLabel>
        <useMessage>{PAWN_nameDef} smashed the Portrait of Another World egg, dissolving it into Enkephalin Boxes.</useMessage>
        <useDuration>300</useDuration>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>ChunkRock_Drop</soundOnUsed>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf">
        <leavings>
          <EnkephalinBox>18</EnkephalinBox>
        </leavings>
      </li>
      <li Class="LCAnomalyCore.Comp.CompProperties_Abnormality" />
      <li Class="LCAnomalyCore.Comp.LC_CompProperties_InteractableEgg">
        <compClass>LCAnomalyCore.Comp.LC_CompEgg</compClass>
        <ticksToActivate>0</ticksToActivate>
        <activateTexPath>UI/CodexEntries/PortraitOfAnotherWorld_MenuIcon</activateTexPath>
        <activateLabelString>Smash...</activateLabelString>
        <activateDescString>Smash the Portrait of Another World egg.</activateDescString>
        <activatingStringPending>smashing Portrait of Another World egg</activatingStringPending>
        <guiLabelString>Choose who should do this</guiLabelString>
        <showMustBeActivatedByColonist>false</showMustBeActivatedByColonist>
        <shouldTransferBioSignature>true</shouldTransferBioSignature>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>HE</abnormalityCategoryDef>
      </li>
    </modExtensions>
  </LCAnomalyCore.Defs.ThingDef_AbnormalityEgg>

