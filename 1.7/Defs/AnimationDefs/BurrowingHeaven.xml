            <li><tick>0</tick><offset>(0,0,0)</offset><scale>(1,1,1)</scale></li>
            <li><tick>60</tick><offset>(0,0,0.03)</offset><scale>(1.02,1,1.02)</scale></li>
            <li><tick>120</tick><offset>(0,0,0)</offset><scale>(1,1,1)</scale></li>
