<Defs>

  <!-- ==================== 1. CONTAINED IDLE (Perch + Perched Songbird) ==================== -->
  <!-- Combines SmallBirdPerch.fbx (smallbird_횃대_animation, 2.0s) and SmallBirdDef.fbx (smallbird_default_Baked + default2/3) -->
  <AnimationDef>
    <defName>PunishingBird_Idle</defName>
    <durationTicks>120</durationTicks>
    <startOnRandomTick>true</startOnRandomTick>
    <playWhenDowned>true</playWhenDowned>
    <keyframeParts>
      <!-- Gentle pendulum sway of the perch chain (smallbird_횃대_animation: +2.7deg <-> -5.2deg) -->
      <li>
        <key>PunishingBird_PerchChain</key>
        <value>
          <workerType>AnimationWorker_Keyframes</workerType>
          <pivot>(0.195, 0.361)</pivot>
          <keyframes>
            <li><tick>0</tick><angle>-2.7</angle></li>
            <li><tick>60</tick><angle>5.2</angle></li>
            <li><tick>120</tick><angle>-2.7</angle></li>
          </keyframes>
        </value>
      </li>
      <!-- Secondary lagging swing of the hanging dagger (0deg <-> -5.1deg) -->
