<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Fairy Festival animations are driven natively by FairySpineRuntime (97 Spine bones + 12 weighted meshes).
       These AnimationDefs maintain RimWorld PawnRenderTree animation state transitions without applying redundant root transforms. -->

  <AnimationDef>
    <defName>FairyFestival_Idle</defName>
    <durationTicks>180</durationTicks>
    <startOnRandomTick>true</startOnRandomTick>
    <playWhenDowned>true</playWhenDowned>
    <keyframeParts>
      <li>
        <key>Fairy_Root</key>
        <value>
          <workerType>AnimationWorker_Keyframes</workerType>
          <keyframes>
            <li><tick>0</tick><offset>(0,0,0)</offset><angle>0</angle><scale>(1,1,1)</scale></li>
            <li><tick>180</tick><offset>(0,0,0)</offset><angle>0</angle><scale>(1,1,1)</scale></li>
          </keyframes>
        </value>
      </li>
    </keyframeParts>
  </AnimationDef>

